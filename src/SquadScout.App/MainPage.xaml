<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SquadScout.App.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,40"
            Spacing="18">
            <Label
                Text="SquadScout"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />

            <Label
                Text="Mobile shell scaffold is in place. Session transcript UX, PubSub transport, and voice workflows land in later backlog items."
                Style="{StaticResource SubHeadline}" />

            <Label
                Text="This project currently references the shared contracts assembly so later session and project flows can land without solution reshaping." />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
