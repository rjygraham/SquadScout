<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>SquadScout.Broker</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SquadScout.Contracts\SquadScout.Contracts.csproj" />
    <ProjectReference Include="..\SquadScout.ServiceDefaults\SquadScout.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Messaging.WebPubSub" Version="1.5.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="Microsoft.Orleans.Persistence.AdoNet" Version="10.0.0-rc.2" />
    <PackageReference Include="Microsoft.Orleans.Server" Version="10.0.0-rc.2" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.0" />
    <PackageReference Include="sch.pty.net" Version="0.3.36-pre" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Orleans\Scripts\*.sql" />
  </ItemGroup>

  <Target Name="CopyPtyNetNativeFiles" AfterTargets="Build" Condition="'$(PlatformTarget)' != '' and '$(PlatformTarget)' != 'AnyCPU'">
    <ItemGroup>
      <PtyNetNativeFiles Include="$(Pkgsch_pty_net)\build\$(PlatformTarget)\**\*" />
    </ItemGroup>

    <Copy SourceFiles="@(PtyNetNativeFiles)" DestinationFiles="@(PtyNetNativeFiles->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
