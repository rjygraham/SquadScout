{
  "Broker": {
    "ListenUrl": "http://127.0.0.1:5071",
    "ProjectRegistryPath": ".squadscout\\projects.json"
  },
  "CopilotPty": {
    "ExecutablePath": "copilot",
    "InitialRows": 30,
    "InitialColumns": 120,
    "OutputBufferSize": 1024
  },
  "AzureWebPubSub": {
    "Hub": "squadscout"
  },
  "Orleans": {
    "Enabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost"
}
