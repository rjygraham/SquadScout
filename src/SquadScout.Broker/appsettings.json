{
  "Broker": {
    "ListenUrl": "http://127.0.0.1:5071",
    "ProjectRegistryPath": ".squadscout\\projects.json"
  },
  "CopilotPty": {
    "ExecutablePath": "copilot",
    "InitialRows": 30,
    "InitialColumns": 120,
    "OutputBufferSize": 1024,
    "MaxInputCharactersPerWrite": 4096
    // WorkingDirectory: Optional fallback when project has no RepositoryRoot.
    // In normal operation, each session uses its project's RepositoryRoot as the working directory.
    // Resolution priority: 1) Project RepositoryRoot, 2) This fallback, 3) Broker process directory.
  },
  "AzureWebPubSub": {
    "Hub": "squadscout",
    "ConnectionString": "",
    "TrustedUpstreamPrincipalIds": []
  },
  "Orleans": {
    "Enabled": false,
    "ClusterId": "squadscout-local",
    "ServiceId": "SquadScout.Broker",
    "SiloPort": 11111,
    "GatewayPort": 30000,
    "StorageProvider": "AdoNetStore",
    "AdoNetInvariant": "Microsoft.Data.Sqlite",
    "SqliteConnectionString": "Data Source=.squadscout\\orleans\\squadscout.db;Mode=ReadWriteCreate;Cache=Shared",
    "AutoInitializeSchema": true
    // Safe migration toggle: leave Enabled=false to keep the Phase 1 in-memory session/project path.
    // When Enabled=true, the broker starts a local Orleans silo and bootstraps SQLite,
    // but session/project services stay in-memory until the follow-on grain migration issues land.
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
